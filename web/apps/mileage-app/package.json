{
  "name": "@obop/mileage-app",
  "version": "0.0.0",
  "private": true,
  "description": "obop Mileage: React Native (Expo SDK 58) app that records a trip.",
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "check:sdk": "node scripts/check-sdk.mjs",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:build": "node scripts/gradle.mjs assembleDebug",
    "android:build:release": "node scripts/gradle.mjs assembleRelease",
    "ios:prebuild": "expo prebuild --platform ios --no-install",
    "ios:pods": "node scripts/ios/xcode.mjs pods",
    "ios:build:simulator": "node scripts/ios/xcode.mjs build-simulator",
    "ios:gate": "node scripts/ios/gate.mjs",
    "ios:run:device": "expo run:ios --device --configuration Release",
    "check:sdk:latest": "node scripts/check-sdk.mjs --latest",
    "emulator:route": "node scripts/emulator/route.mjs",
    "emulator:drive": "node scripts/emulator/drive.mjs",
    "emulator:check": "node scripts/emulator/check-trip.mjs",
    "simulator:route": "node scripts/simulator/route.mjs"
  },
  "dependencies": {
    "@obop/client": "workspace:*",
    "@obop/trip-core": "workspace:*",
    "@obop/ui-native": "workspace:*",
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-location": "58.0.18",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.6",
    "expo-task-manager": "58.0.12",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
