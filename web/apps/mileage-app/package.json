{
  "name": "@obop/mileage-app",
  "version": "0.0.0",
  "private": true,
  "description": "obop Mileage: React Native (Expo SDK 58) app that records a trip.",
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "export:android": "expo export --platform android",
    "check:sdk": "node scripts/check-sdk.mjs",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:build": "node scripts/gradle.mjs assembleDebug",
    "android:build:release": "node scripts/gradle.mjs assembleRelease",
    "check:sdk:latest": "node scripts/check-sdk.mjs --latest"
  },
  "dependencies": {
    "@obop/client": "workspace:*",
    "@obop/trip-core": "workspace:*",
    "expo": "58.0.16",
    "expo-dev-client": "58.0.14",
    "expo-location": "58.0.18",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "expo-task-manager": "58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
