{
  "name": "@obop/client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client of an obop instance, generated from its OpenAPI document and shared by the web back office and the mobile apps.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:types": "openapi-typescript openapi.json --output src/generated/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
