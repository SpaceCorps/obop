# Rust
/target/
**/*.rs.bk
# Cargo.lock IS committed (application workspace)

# JavaScript / Vite+ (vp + pnpm only; pnpm-lock.yaml IS committed)
node_modules/
.pnpm-store/
dist/
/web/apps/backoffice/dist-admin/
.vite/
coverage/
*.tsbuildinfo
# Any lockfile other than pnpm-lock.yaml is forbidden (docs/DECISIONS.md F2); CI fails on them.
# They are also ignored here so they are never committed by accident.
package-lock.json
npm-shrinkwrap.json
yarn.lock
bun.lock
bun.lockb

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local data
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
# Cross-process lock files next to a SQLite database (docs/DEPLOY.md)
*.db.lock-*
/.data/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Claude Code local state (CLAUDE.md is committed)
.claude/settings.local.json
.claude/worktrees/

# Scratch
/.work/
*.log
web/site/

# Playwright output (web/packages/e2e)
test-results/
playwright-report/
blob-report/
